// FilmCraft AI — Prisma schema
// Xem BACKEND_PROMPT.md để biết bối cảnh & quy cách dữ liệu đầy đủ.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Cấu hình nền tảng (admin) — key/value đơn giản, hiện dùng cho override giá
// theo JobType (key = "price:<JobType>"). Không lưu secret/API key ở đây —
// key thật vẫn chỉ nằm trong .env, xem lib/platformSettings.ts.
// ---------------------------------------------------------------------------

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Auth / User
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String?
  role          UserRole       @default(USER)
  createdAt     DateTime       @default(now())
  dramaProjects DramaProject[]
  videoProjects VideoProject[]
  assets        Asset[]
  wallet        Wallet?
  jobs          GenerationJob[]
}

// ---------------------------------------------------------------------------
// Kịch bản phim (Drama) — Lớp 1: Tóm tắt dự án
// ---------------------------------------------------------------------------

model DramaProject {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  title         String
  coverGradient String // giữ tương thích FE hiện tại (from-x to-y)
  status        ProjectStatus @default(DRAFT)
  summary       ProjectSummary?
  characters    Character[]
  episodes      Episode[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ProjectSummary {
  id             String       @id @default(cuid())
  projectId      String       @unique
  project        DramaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeCount   Int
  storyGenre     String
  targetAudience String
  coreHook       String
  logline        String       @db.Text
  fullSummary    String       @db.Text
  visualStyle    String
  updatedAt      DateTime     @updatedAt
}

// ---------------------------------------------------------------------------
// Lớp 2 — Tiểu sử nhân vật
// ---------------------------------------------------------------------------

model Character {
  id                 String        @id @default(cuid())
  projectId          String
  project            DramaProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  characterType      CharacterType @default(SUPPORTING)
  visualDescription  String        @db.Text
  coreTags           String[]
  background         String        @db.Text
  personality        String        @db.Text
  referenceImageUrl  String?
  voiceAssetId       String? // liên kết Asset(category: VOICE) đã gắn cho nhân vật
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

// ---------------------------------------------------------------------------
// Lớp 3 — Kịch bản từng tập: Episode -> Scene -> Shot / DialogueLine
// ---------------------------------------------------------------------------

model Episode {
  id        String        @id @default(cuid())
  projectId String
  project   DramaProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  index     Int // thứ tự tập, 1..N
  title     String
  summary   String // 1 câu tóm tắt hiển thị ở sidebar
  scriptRaw String        @db.Text // nguồn sự thật — markdown kịch bản
  status    EpisodeStatus @default(DRAFT)
  scenes    Scene[]
  segments  Segment[]

  // cài đặt cấp tập (kế thừa mặc định dự án nếu null)
  ratio         String?
  resolution    String?
  videoModel    String?
  subtitleMode  String? // "auto" | "post"
  stitchEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, index])
}

model Scene {
  id                String   @id @default(cuid())
  episodeId         String
  episode           Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  sceneNumber       Int // số cảnh trong tập (phần sau dấu "-")
  timeOfDay         String? // "Sáng", "Đêm"...
  interiorExterior  String? // "Nội" | "Ngoại"
  location          String
  subLocation       String?
  charactersPresent String[]
  shots             Shot[]
  order             Int
}

model Shot {
  id          String         @id @default(cuid())
  sceneId     String
  scene       Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  order       Int
  shotSize    ShotSize
  description String         @db.Text
  dialogue    DialogueLine[]
  imageUrl    String?
  videoUrl    String?
  durationSec Float?
}

model DialogueLine {
  id            String @id @default(cuid())
  shotId        String
  shot          Shot   @relation(fields: [shotId], references: [id], onDelete: Cascade)
  characterName String
  direction     String?
  text          String @db.Text
  voiceUrl      String?
  order         Int
}

// ---------------------------------------------------------------------------
// Lớp 4 — Segment editor (đoạn phim gửi sinh video) + Seedance pipeline
// ---------------------------------------------------------------------------

model Segment {
  id           String          @id @default(cuid())
  episodeId    String
  episode      Episode         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  order        Int
  title        String // "Đoạn phim 01"
  durationSec  Int // tổng thời lượng, <= 30
  status       SegmentStatus   @default(PENDING)
  lines        SegmentLine[]
  videoUrl     String?
  lastFrameUrl String? // ghi lại khi return_last_frame=true
  jobs         GenerationJob[]
}

model SegmentLine {
  id            String         @id @default(cuid())
  segmentId     String
  segment       Segment        @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  order         Int
  tag           SegmentLineTag
  durationSec   Int            @default(0)
  characterName String?
  direction     String?
  shotType      String? // "Toàn cảnh" | "Trung cảnh" | "Cận cảnh" | "Đặc tả" ...
  text          String         @db.Text
}

// ---------------------------------------------------------------------------
// Video ngắn AI
// ---------------------------------------------------------------------------

model VideoProject {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  title            String
  status           VideoStatus     @default(DRAFT)
  templateId       String
  topic            String          @db.Text
  durationRange    String // "1-3" | "3-5" | "5-8"
  audience         String
  visualStyleId    String
  characterStyleId String
  voiceId          String
  ratio            String // "16:9" | "9:16"
  scenes           VideoScene[]
  jobs             GenerationJob[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model VideoScene {
  id             String       @id @default(cuid())
  videoProjectId String
  videoProject   VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  order          Int
  title          String
  description    String       @db.Text
  startSec       Float
  endSec         Float
  imageUrl       String?
  videoUrl       String?
}

// ---------------------------------------------------------------------------
// Tài sản (Assets)
// ---------------------------------------------------------------------------

model Asset {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  projectId String? // null nếu là tài sản dùng chung / "Trung tâm cá nhân"
  category  AssetCategory
  name      String
  imageUrl  String?
  metadata  Json?
  createdAt DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Ví & thanh toán
// ---------------------------------------------------------------------------

model Wallet {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  balance      Int           @default(0) // đơn vị: đồng, hoặc "token" quy đổi
  heldAmount   Int           @default(0) // đang tạm giữ cho job chưa hoàn tất
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  type        TxType
  amount      Int // dương = cộng, âm = trừ
  description String
  jobId       String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Generation jobs (hàng đợi AI)
// ---------------------------------------------------------------------------

model GenerationJob {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  type           JobType
  status         JobStatus     @default(QUEUED)
  targetType     String // "Episode" | "Shot" | "VideoScene" | "Character" | "Segment" ...
  targetId       String
  estimatedCost  Int
  actualCost     Int?
  resultUrl      String?
  error          String?
  provider       String? // "seedance-2.5" | "seedance-1.5" | "mock" | ...
  requestPayload Json? // snapshot request đa phương thức đã gửi
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  videoProjectId String?
  videoProject   VideoProject? @relation(fields: [videoProjectId], references: [id])

  segmentId String?
  segment   Segment? @relation(fields: [segmentId], references: [id])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum VideoStatus {
  DRAFT
  GENERATING
  COMPLETED
  PUBLISHED
}

enum EpisodeStatus {
  DRAFT
  STORYBOARD_READY
  RENDERED
}

enum CharacterType {
  PROTAGONIST
  DEUTERAGONIST
  ANTAGONIST
  SUPPORTING
  GROUP
}

enum AssetCategory {
  CHARACTER
  SCENE
  PROP
  VOICE
}

enum ShotSize {
  WIDE
  MEDIUM
  CLOSE_UP
  EXTREME_CLOSE_UP
  MONTAGE
}

enum TxType {
  TOPUP
  USAGE_HOLD
  USAGE_SETTLE
  REFUND
}

enum JobType {
  SCRIPT
  SUMMARY
  CHARACTER_IMAGE
  SHOT_IMAGE
  SHOT_VIDEO
  VOICE
  STORYBOARD
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum SegmentStatus {
  PENDING
  GENERATING
  DONE
  FAILED
}

enum SegmentLineTag {
  SUBTITLE_CONFIG
  BGM
  DIALOGUE
  VISUAL
}
