generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum VideoStatus {
  DRAFT
  GENERATING
  COMPLETED
  PUBLISHED
}

enum EpisodeStatus {
  DRAFT
  STORYBOARD_READY
  RENDERED
}

enum CharacterType {
  PROTAGONIST
  DEUTERAGONIST
  ANTAGONIST
  SUPPORTING
  GROUP
}

enum AssetCategory {
  CHARACTER
  SCENE
  PROP
  VOICE
}

enum ShotSize {
  WIDE
  MEDIUM
  CLOSE_UP
  EXTREME_CLOSE_UP
  MONTAGE
}

enum TxType {
  TOPUP
  USAGE_HOLD
  USAGE_SETTLE
  REFUND
}

enum JobType {
  SCRIPT
  SUMMARY
  CHARACTER_IMAGE
  SHOT_IMAGE
  SHOT_VIDEO
  VOICE
  STORYBOARD
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum SegmentStatus {
  PENDING
  GENERATING
  DONE
  FAILED
}

enum SegmentLineTag {
  SUBTITLE_CONFIG
  BGM
  DIALOGUE
  VISUAL
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String?
  createdAt     DateTime       @default(now())
  dramaProjects DramaProject[]
  videoProjects VideoProject[]
  assets        Asset[]
  wallet        Wallet?
  jobs          GenerationJob[]
}

model DramaProject {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  coverGradient String        @default("from-indigo-400 to-slate-700")
  status        ProjectStatus @default(DRAFT)
  summary       ProjectSummary?
  characters    Character[]
  episodes      Episode[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, status])
}

model ProjectSummary {
  id             String       @id @default(cuid())
  projectId      String       @unique
  project        DramaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeCount   Int          @default(8)
  storyGenre     String       @default("")
  targetAudience String       @default("")
  coreHook       String       @default("")
  logline        String       @default("") @db.Text
  fullSummary    String       @default("") @db.Text
  visualStyle    String       @default("")
  updatedAt      DateTime     @updatedAt
}

model Character {
  id                String        @id @default(cuid())
  projectId         String
  project           DramaProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String
  characterType     CharacterType @default(SUPPORTING)
  visualDescription String        @default("") @db.Text
  coreTags          String[]      @default([])
  background        String        @default("") @db.Text
  personality       String        @default("") @db.Text
  referenceImageUrl String?
  createdAt         DateTime      @default(now())

  @@index([projectId])
}

model Episode {
  id          String        @id @default(cuid())
  projectId   String
  project     DramaProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  index       Int
  title       String
  summary     String        @default("") @db.Text
  scriptRaw   String        @default("") @db.Text
  status      EpisodeStatus @default(DRAFT)
  ratio       String        @default("9:16")
  resolution  String        @default("720p")
  videoModel  String        @default("Seedance 2.5")
  subtitleMode String       @default("auto")
  stitchEnabled Boolean     @default(false)
  scenes      Scene[]
  segments    Segment[]
  updatedAt   DateTime      @updatedAt

  @@unique([projectId, index])
  @@index([projectId])
}

model Scene {
  id                String   @id @default(cuid())
  episodeId         String
  episode           Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  sceneNumber       Int
  timeOfDay         String?
  interiorExterior  String?
  location          String   @default("")
  subLocation       String?
  charactersPresent String[] @default([])
  order             Int      @default(0)
  shots             Shot[]

  @@index([episodeId])
}

model Shot {
  id          String   @id @default(cuid())
  sceneId     String
  scene       Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  shotSize    ShotSize @default(MEDIUM)
  description String   @default("") @db.Text
  dialogue    DialogueLine[]
  imageUrl    String?
  videoUrl    String?
  durationSec Float?

  @@index([sceneId])
}

model DialogueLine {
  id            String @id @default(cuid())
  shotId        String
  shot          Shot   @relation(fields: [shotId], references: [id], onDelete: Cascade)
  characterName String
  direction     String?
  text          String @db.Text
  voiceUrl      String?
  order         Int    @default(0)

  @@index([shotId])
}

model Segment {
  id           String        @id @default(cuid())
  episodeId    String
  episode      Episode       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  order        Int           @default(0)
  title        String        @default("")
  durationSec  Int           @default(0)
  status       SegmentStatus @default(PENDING)
  lines        SegmentLine[]
  videoUrl     String?
  lastFrameUrl String?
  jobs         GenerationJob[]

  @@index([episodeId])
}

model SegmentLine {
  id            String         @id @default(cuid())
  segmentId     String
  segment       Segment        @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  order         Int            @default(0)
  tag           SegmentLineTag @default(VISUAL)
  durationSec   Int            @default(0)
  characterName String?
  direction     String?
  shotType      String?
  text          String         @db.Text

  @@index([segmentId])
}

model VideoProject {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  status           VideoStatus @default(DRAFT)
  templateId       String      @default("")
  topic            String      @default("") @db.Text
  durationRange    String      @default("1-3")
  audience         String      @default("")
  visualStyleId    String      @default("")
  characterStyleId String      @default("")
  voiceId          String      @default("")
  ratio            String      @default("16:9")
  subtitleMode     String      @default("auto")
  videoModel       String      @default("seedance-2.5")
  scenes           VideoScene[]
  jobs             GenerationJob[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId])
}

model VideoScene {
  id             String       @id @default(cuid())
  videoProjectId String
  videoProject   VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  order          Int          @default(0)
  title          String
  description    String       @db.Text
  startSec       Float        @default(0)
  endSec         Float        @default(0)
  imageUrl       String?
  videoUrl       String?

  @@index([videoProjectId])
}

model Asset {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  category  AssetCategory @default(CHARACTER)
  name      String
  imageUrl  String?
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([userId, category])
}

model Wallet {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Int           @default(0)
  heldAmount   Int           @default(0)
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        TxType
  amount      Int
  description String
  jobId       String?
  createdAt   DateTime @default(now())

  @@index([walletId])
}

model GenerationJob {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           JobType
  status         JobStatus @default(QUEUED)
  targetType     String
  targetId       String
  estimatedCost  Int       @default(0)
  actualCost     Int?
  resultUrl      String?
  error          String?
  provider       String?
  requestPayload Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  videoProjectId String?
  videoProject   VideoProject? @relation(fields: [videoProjectId], references: [id], onDelete: SetNull)
  segmentId      String?
  segment        Segment?  @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([targetType, targetId])
}
